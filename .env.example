# Copy to .env (never commit .env). All values are optional for the hackathon demo.

# One-click demo sign-in (analyst / compliance officer). Set to false outside demos.
CYGNUS_DEMO_MODE=true

# Secret that signs session tokens. Leave empty to generate a random one at each start
# (everyone is signed out when the backend restarts).
CYGNUS_AUTH_SECRET=

# Passwords for the two built-in accounts ("analyst" and "admin"). Leave empty to disable
# password sign-in for that account.
CYGNUS_ANALYST_PASSWORD=
CYGNUS_ADMIN_PASSWORD=

# Optional: lets Claude write the AI Investigator narrative. Without it the rule-based briefing is used.
ANTHROPIC_API_KEY=
